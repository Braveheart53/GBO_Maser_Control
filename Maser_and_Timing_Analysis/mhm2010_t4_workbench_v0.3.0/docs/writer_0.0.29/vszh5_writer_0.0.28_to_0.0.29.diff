+def _exact_wall_text(epoch: float, offset: float) -> str:
+    """(0.0.29) Local wall-clock ISO text of one epoch value with every digit
+    of its shortest round-trip decimal (no offset suffix).
+
+    The decimal of repr(epoch) is exact for the float, the offset is a whole
+    number of seconds for every real zone, so whole seconds and fraction are
+    split in Decimal arithmetic without any rounding; the date part comes
+    from whole seconds (datetime has no sub-microsecond digits).
+    """
+    exact = Context(prec=80)                        # wide enough: no rounding
+    wall = exact.add(Decimal(repr(epoch)), Decimal(repr(offset)))
+    whole = wall.to_integral_value(rounding=ROUND_FLOOR)
+    fraction = exact.subtract(wall, whole)          # 0 <= fraction < 1, exact
+    stamp = _dt.datetime(1970, 1, 1) + _dt.timedelta(seconds=int(whole))
+    text = stamp.isoformat(timespec="seconds")
+    if fraction:
+        digits = format(fraction, "f").partition(".")[2].rstrip("0")
+        if digits:
+            text += "." + digits
+    return text
+
