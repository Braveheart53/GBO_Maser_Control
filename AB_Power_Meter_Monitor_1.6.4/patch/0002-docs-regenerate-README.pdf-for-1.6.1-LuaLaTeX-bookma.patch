diff --git a/docs/tools/README_pdf.sh b/docs/tools/README_pdf.sh
new file mode 100755
index 0000000..b2f5203
--- /dev/null
+++ b/docs/tools/README_pdf.sh
@@ -0,0 +1,21 @@
+#!/usr/bin/env bash
+# =============================================================================
+#  README_pdf.sh - render README.md to the bookmarked README.pdf (LuaLaTeX)
+#  Version : 1.0.0   Created/Modified: 2026-10-26   Author: W. W. Wallace
+#  Needs   : pandoc >= 3, LuaLaTeX (TeX Live), DejaVu fonts, fvextra, xurl
+#  Usage   : cd <repo> && docs/tools/README_pdf.sh
+# =============================================================================
+set -euo pipefail
+here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+repo="$(cd "$here/../.." && pwd)"
+pandoc "$repo/README.md" \
+  -f markdown+gfm_auto_identifiers+pipe_tables+tex_math_dollars-implicit_figures \
+  -o "$repo/README.pdf" --pdf-engine=lualatex \
+  --lua-filter="$here/colwidths.lua" -H "$here/header.tex" \
+  -V mainfont="DejaVu Serif" -V monofont="DejaVu Sans Mono" -V monofontoptions="Scale=0.80" \
+  -V mathfont="Latin Modern Math" -V fontsize=10pt -V geometry:margin=1.7cm \
+  -V colorlinks=true -V linkcolor=blue -V urlcolor=blue \
+  -V hyperrefoptions=bookmarksopen=true -V hyperrefoptions=pdfpagemode=UseOutlines \
+  -M title="AB Power Meter Monitor 1.6.1 - Deployment and Integration Guide" \
+  -M author="William W. Wallace, NRAO/GBO" -M date="2026-10-26" --toc --toc-depth=2
+echo "written: $repo/README.pdf"
diff --git a/docs/tools/colwidths.lua b/docs/tools/colwidths.lua
new file mode 100644
index 0000000..39c882d
--- /dev/null
+++ b/docs/tools/colwidths.lua
@@ -0,0 +1,24 @@
+-- colwidths.lua: give every table relative column widths proportional to the
+-- longest cell text in each column (6..60 characters), so LaTeX wraps cells
+-- inside the text width instead of letting wide tables run off the page.
+function Table(tbl)
+  local n = #tbl.colspecs
+  local longest = {}
+  for i = 1, n do longest[i] = 3 end
+  local function scan(rows)
+    for _, row in ipairs(rows) do
+      for i, cell in ipairs(row.cells) do
+        if i <= n then
+          local len = utf8.len(pandoc.utils.stringify(cell.contents)) or 3
+          if len > longest[i] then longest[i] = len end
+        end
+      end
+    end
+  end
+  scan(tbl.head.rows)
+  for _, body in ipairs(tbl.bodies) do scan(body.body) end
+  local total = 0
+  for i = 1, n do longest[i] = math.min(math.max(longest[i], 6), 60); total = total + longest[i] end
+  for i = 1, n do tbl.colspecs[i][2] = 0.98 * longest[i] / total end
+  return tbl
+end
diff --git a/docs/tools/header.tex b/docs/tools/header.tex
new file mode 100644
index 0000000..e89fd85
--- /dev/null
+++ b/docs/tools/header.tex
@@ -0,0 +1,7 @@
+% Wrap long lines in code blocks and URLs; ragged-right table cells.
+\usepackage{fvextra}
+\DefineVerbatimEnvironment{Highlighting}{Verbatim}{breaklines,breakanywhere,commandchars=\\\{\}}
+\usepackage{xurl}
+\usepackage{array}
+\let\oldtabular\tabular
+\renewcommand{\arraystretch}{1.12}
