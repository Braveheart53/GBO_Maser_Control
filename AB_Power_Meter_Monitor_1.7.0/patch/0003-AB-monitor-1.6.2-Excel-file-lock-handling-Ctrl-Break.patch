diff --git a/tests/test_windows_file_locks.py b/tests/test_windows_file_locks.py
new file mode 100644
index 0000000..6a1bb3f
--- /dev/null
+++ b/tests/test_windows_file_locks.py
@@ -0,0 +1,283 @@
+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+# SPDX-License-Identifier: GPL-3.0-or-later
+# SPDX-FileCopyrightText: 2026 William W. Wallace <wwallace@nrao.edu>
+# %% ===========================================================================
+#    MODULE HEADER
+# =============================================================================
+"""Output files held open by another program (Excel) while the monitor logs.
+
+===============================================================================
+ Title          : AB Power Meter Monitor - locked-output-file test
+ Filename       : tests/test_windows_file_locks.py
+ Version        : 0.0.2 (Semantic Versioning 2.0.0, MAJOR.MINOR.PATCH)
+ Author         : William W. Wallace
+ Company        : NRAO/GBO
+ Email          : wwallace@nrao.edu
+ Created        : 2026-10-26
+ Modified       : 2026-10-26
+ Language       : Python 3.8 through 3.12 (Windows and Linux)
+ Requires       : the monitor's dependencies (numpy, h5py, astropy, openpyxl)
+ Licence        : GPL-3.0-or-later (GNU General Public License v3.0 or later)
+ Status         : Internal draft
+===============================================================================
+
+How the files are locked
+------------------------
+Windows  A helper process opens the files with CreateFileW(GENERIC_READ,
+         FILE_SHARE_READ) - what Excel does with an open CSV or workbook:
+         other programs may read the file, but appending, replacing or
+         renaming it fails (sharing violation). CSV, Markdown, XLSX and FITS
+         of one meter are locked.
+Other    No mandatory locks exist, so the monitor's own open() is wrapped to
+         raise PermissionError for the "locked" CSV and Markdown files (the
+         same exception Windows raises). XLSX/FITS are covered on Windows only.
+
+Checks
+------
+1  While locked: no exception, no ERROR record, exactly ONE "open in another
+   program" warning per file (1.6.x logged an error per table per poll).
+2  A RAM flush while locked persists every row (rows_kept_unpersisted = 0)
+   by writing rescue files.
+3  After unlocking, the next writes merge the rescue files back: every
+   output holds exactly one row per poll, in time order, no duplicates, and
+   no *_rescue.* or *.merging file is left.
+4  _rescue_files() of Diagnostic_Table ignores the rescue files of
+   Diagnostic_Table_Extended (name-prefix trap) and returns rescue files of
+   the same second in creation order ("_rescue" before "_2_rescue").
+5  New Markdown rows after a merged rescue section start a "(continued)"
+   section (they are not filed under the rescue section's heading).
+
+Usage:  python tests/test_windows_file_locks.py
+
+REVISION HISTORY
+----------------
+0.0.2  2026-10-26  Rescue files of one second are merged in creation order;
+                   checks the Markdown "(continued)" section.
+0.0.1  2026-10-26  First version (monitor 1.6.2).
+===============================================================================
+"""
+
+# %% IMPORTS ===================================================================
+from __future__ import annotations
+
+import builtins
+import csv
+import logging
+import os
+import socket
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE.parent))
+sys.path.insert(0, str(HERE))
+import ab_power_meter_monitor as abm  # noqa: E402
+from ab_meter_emulator import start_emulators  # noqa: E402
+
+WINDOWS = sys.platform == "win32"
+HOSTS = ["127.0.0.2", "127.0.0.3"]
+LOCKED_TABLE = "Real_Time_Power_Table"
+
+# Helper run in a separate process on Windows: holds the files like Excel does
+# until a line arrives on stdin.
+_LOCKER = r'''
+import ctypes, sys
+from ctypes import wintypes
+k32 = ctypes.WinDLL("kernel32", use_last_error=True)
+k32.CreateFileW.argtypes = [wintypes.LPCWSTR, wintypes.DWORD, wintypes.DWORD, ctypes.c_void_p,
+                            wintypes.DWORD, wintypes.DWORD, wintypes.HANDLE]
+k32.CreateFileW.restype = wintypes.HANDLE
+k32.CloseHandle.argtypes = [wintypes.HANDLE]
+GENERIC_READ, FILE_SHARE_READ, OPEN_EXISTING, NORMAL = 0x80000000, 0x1, 3, 0x80
+INVALID = ctypes.c_void_p(-1).value
+handles = []
+for path in sys.argv[1:]:
+    handle = k32.CreateFileW(path, GENERIC_READ, FILE_SHARE_READ, None, OPEN_EXISTING, NORMAL, None)
+    if handle in (None, INVALID):
+        print("FAIL", path, ctypes.get_last_error(), flush=True)
+        sys.exit(1)
+    handles.append(handle)
+print("locked", len(handles), flush=True)
+sys.stdin.readline()
+for handle in handles:
+    k32.CloseHandle(handle)
+print("unlocked", flush=True)
+'''
+
+
+# %% HELPERS ===================================================================
+class _Records(logging.Handler):
+    """Keeps every WARNING+ record of the monitor logger."""
+
+    def __init__(self) -> None:
+        super().__init__(logging.WARNING)
+        self.records = []
+
+    def emit(self, record: logging.LogRecord) -> None:
+        self.records.append(record)
+
+
+class _Lock:
+    """Hold ``paths`` open like Excel (Windows) or simulate it (elsewhere)."""
+
+    def __init__(self, paths) -> None:
+        self.paths = [os.path.abspath(p) for p in paths]
+        self.proc = None
+
+    def __enter__(self) -> "_Lock":
+        if WINDOWS:
+            self.proc = subprocess.Popen([sys.executable, "-c", _LOCKER] + self.paths,
+                                         stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True)
+            line = self.proc.stdout.readline().strip()
+            assert line.startswith("locked"), line
+        else:
+            locked = set(self.paths)
+
+            def guarded_open(file, mode="r", *args, **kwargs):
+                if any(c in mode for c in "wax+") and os.path.abspath(str(file)) in locked:
+                    raise PermissionError(13, "Permission denied (simulated Excel lock)", str(file))
+                return builtins.open(file, mode, *args, **kwargs)
+            abm.open = guarded_open                      # shadows the builtin in the monitor only
+        return self
+
+    def check_blocks(self, path: str) -> None:
+        """The lock must really stop an append (validates the test itself)."""
+        opener = getattr(abm, "open", builtins.open)
+        try:
+            with opener(path, "a"):
+                pass
+        except PermissionError:
+            return
+        raise AssertionError(f"lock does not block appends to {path}")
+
+    def __exit__(self, *exc) -> None:
+        if self.proc is not None:
+            self.proc.stdin.write("\n")
+            self.proc.stdin.flush()
+            self.proc.wait(timeout=30)
+        elif hasattr(abm, "open"):
+            del abm.open
+
+
+def _free_port() -> int:
+    with socket.socket() as probe:
+        probe.bind(("127.0.0.1", 0))
+        return probe.getsockname()[1]
+
+
+def _csv_stamps(path: str) -> list:
+    with open(path, newline="", encoding="utf-8") as handle:
+        return [row[0] for row in list(csv.reader(handle))[2:] if row]
+
+
+def _md_rows(path: str) -> int:
+    with open(path, encoding="utf-8") as handle:
+        return sum(1 for line in handle if line.startswith("| ") and not line.startswith("| Timestamp_Local"))
+
+
+def _leftovers(folder: str) -> list:
+    return sorted(str(p) for p in Path(folder).rglob("*") if "_rescue" in p.name or p.name.endswith(".merging"))
+
+
+# %% TESTS =====================================================================
+def test_rescue_name_matching() -> None:
+    folder = tempfile.mkdtemp(prefix="abm_lk0_")
+    base = os.path.join(folder, "ABMeter_10_0_0_1_Diagnostic_Table.csv")
+    for name in ("ABMeter_10_0_0_1_Diagnostic_Table_20261026_101500_rescue.csv",
+                 "ABMeter_10_0_0_1_Diagnostic_Table_20261026_101500_2_rescue.csv",
+                 "ABMeter_10_0_0_1_Diagnostic_Table_Extended_20261026_101500_rescue.csv",
+                 "ABMeter_10_0_0_1_Diagnostic_Table_20261026_101500_rescue.csv.merging"):
+        Path(folder, name).write_text("x", encoding="utf-8")
+    found = [os.path.basename(p) for p in abm._rescue_files(base)]
+    # Creation order: the first rescue file of a second has no counter, the
+    # second one "_2" (a plain name sort would put "_2" first).
+    assert found == ["ABMeter_10_0_0_1_Diagnostic_Table_20261026_101500_rescue.csv",
+                     "ABMeter_10_0_0_1_Diagnostic_Table_20261026_101500_2_rescue.csv"], found
+
+
+def test_locked_outputs_lose_nothing() -> None:
+    port = _free_port()
+    start_emulators(HOSTS, port)
+    folder = tempfile.mkdtemp(prefix="abm_lk1_")
+    abm.OUTPUT_BASE_DIR = folder
+    abm.METER_URL_TEMPLATE = "http://{ip}:%d/{page}" % port
+    abm.IP_LIST = list(HOSTS)
+    abm.HTTP_TIMEOUT_SEC, abm.HTTP_RETRY_COUNT, abm.ENABLE_RAM_FLUSH = 2, 1, 0
+    abm.ENABLE_CSV = abm.ENABLE_LOG_APPEND = 1
+    abm.ENABLE_XLSX = abm.ENABLE_FITS = 1 if WINDOWS else 0
+    abm.ENABLE_VEUSZ = 0
+    abm.FULL_WRITE_EVERY_N_CYCLES = 1
+    abm.set_console_logging(False)
+    records = _Records()
+    logging.getLogger("ABMonitor").addHandler(records)
+    cfg = abm.default_config()
+    abm.begin_run(cfg)
+    polls = 0
+    for _ in range(2):
+        abm.poll_cycle(cfg)
+        polls += 1
+    abm.persist_outputs(cfg, full=True, must_persist=True, reason="test")   # XLSX/FITS exist now
+    ip = "127_0_0_2"
+    csv_path = os.path.join(cfg["csv_dir"], f"ABMeter_{ip}_{LOCKED_TABLE}.csv")
+    md_path = os.path.join(cfg["log_dir"], f"ABMeter_{ip}_{LOCKED_TABLE}.md")
+    targets = [csv_path, md_path]
+    if WINDOWS:
+        targets += [os.path.join(cfg["xlsx_dir"], f"ABMeter_{ip}.xlsx"),
+                    os.path.join(cfg["fits_dir"], f"ABMeter_{ip}.fits")]
+    with _Lock(targets) as lock:
+        lock.check_blocks(csv_path)
+        for _ in range(3):
+            abm.poll_cycle(cfg)
+            polls += 1
+        in_use = [r for r in records.records if "is open in another program" in r.getMessage()]
+        for path in (csv_path, md_path):
+            hits = [r for r in in_use if path in r.getMessage()]
+            assert len(hits) == 1, (path, [r.getMessage() for r in in_use])
+        errors = [r.getMessage() for r in records.records if r.levelno >= logging.ERROR]
+        assert not errors, errors
+        flush = abm.perform_ram_flush(cfg, "test while locked", keep_samples=0)
+        assert flush["rows_kept_unpersisted"] == 0, flush
+        assert abm._rescue_files(csv_path) and abm._rescue_files(md_path)
+        abm.poll_cycle(cfg)                              # still locked: rows kept in memory
+        polls += 1
+    for _ in range(2):                                   # unlocked: rescue files merged back
+        abm.poll_cycle(cfg)
+        polls += 1
+    abm.end_run(cfg)
+    logging.getLogger("ABMonitor").removeHandler(records)
+    stamps = _csv_stamps(csv_path)
+    # Exactly one row per poll (a lost row lowers, a duplicate raises the count),
+    # in time order (rescue rows merged before the newer ones). Timestamps have
+    # 1 s resolution and polls run back to back, so equal stamps are genuine.
+    assert len(stamps) == polls, (len(stamps), polls)
+    assert stamps == sorted(stamps), stamps
+    assert _md_rows(md_path) == polls, (_md_rows(md_path), polls)
+    with open(md_path, encoding="utf-8") as handle:
+        text = handle.read()
+    assert "rows written while the log was open elsewhere" in text
+    assert text.index("rows written while the log was open elsewhere") < text.index("(continued)"), \
+        "new rows must follow the merged rescue section in their own section"
+    if WINDOWS:
+        import openpyxl
+        from astropy.io import fits
+        book = openpyxl.load_workbook(targets[2], read_only=True)
+        counts = [sum(1 for _ in ws.iter_rows()) - 2 for ws in book.worksheets]
+        book.close()
+        assert set(counts) == {polls}, counts
+        with fits.open(targets[3]) as hdul:
+            assert all(len(h.data) == polls for h in hdul[1:]), [len(h.data) for h in hdul[1:]]
+    assert not _leftovers(folder), _leftovers(folder)
+    errors = [r.getMessage() for r in records.records if r.levelno >= logging.ERROR]
+    assert not errors, errors
+    print(f"  {polls} polls, lock mode {'CreateFileW (Windows)' if WINDOWS else 'simulated'}; "
+          f"outputs checked: {'CSV, MD, XLSX, FITS' if WINDOWS else 'CSV, MD'}")
+
+
+if __name__ == "__main__":
+    print(f"Python {sys.version.split()[0]} on {sys.platform}, monitor {abm.__version__}")
+    for test in (test_rescue_name_matching, test_locked_outputs_lose_nothing):
+        test()
+        print("PASS", test.__name__)
diff --git a/tests/windows_memory_check.py b/tests/windows_memory_check.py
new file mode 100644
index 0000000..1484e1d
--- /dev/null
+++ b/tests/windows_memory_check.py
@@ -0,0 +1,252 @@
+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+# SPDX-License-Identifier: GPL-3.0-or-later
+# SPDX-FileCopyrightText: 2026 William W. Wallace <wwallace@nrao.edu>
+# %% ===========================================================================
+#    MODULE HEADER
+# =============================================================================
+"""Measure what a RAM flush gives back to Windows (Task Manager's view).
+
+===============================================================================
+ Title          : AB Power Meter Monitor - Windows memory-return measurement
+ Filename       : tests/windows_memory_check.py
+ Version        : 0.0.2 (Semantic Versioning 2.0.0, MAJOR.MINOR.PATCH)
+ Author         : William W. Wallace
+ Company        : NRAO/GBO
+ Email          : wwallace@nrao.edu
+ Created        : 2026-10-26
+ Modified       : 2026-10-26
+ Language       : Python 3.8 through 3.12 (meant for Windows; runs elsewhere
+                  for comparison, with psutil numbers)
+ Requires       : psutil (+ monitor dependencies)
+ Licence        : GPL-3.0-or-later (GNU General Public License v3.0 or later)
+ Status         : Internal draft
+===============================================================================
+
+What it does
+------------
+Each configuration runs in a FRESH Python process (so one cannot inherit the
+heap state of another):
+
+    configuration     MEM_RETURN_TO_OS   MEM_TRIM_WORKING_SET
+    gc_only                  0                    -           (1.6.0 on Windows)
+    heap_only                1                    0
+    full (default)           1                    1
+
+each with keep = 0 (store emptied) and keep = 120 (the GUI keeps the newest
+120 rows per table, which leaves the allocator's arenas partly used - the
+realistic case). Per run: idle -> fill the store with --values float values
+-> flush -> 2 s later. Read directly from Win32 GetProcessMemoryInfo
+(PROCESS_MEMORY_COUNTERS_EX):
+
+    W  WorkingSetSize   Task Manager "Details" tab: Working set (memory)
+    C  PrivateUsage     Task Manager "Details" tab: Commit size
+
+Pass criteria (Windows only)
+----------------------------
+* full, keep 0 and keep 120:  W after the flush <= W idle + 30 % of what the
+  fill added  (the RAM really goes back to Windows).
+* full keeps W lower than gc_only for keep = 120 (the trim does something
+  the allocator alone does not).
+Commit charge is reported, not judged (it depends on heap fragmentation).
+Under Wine (detected via ntdll's wine_get_version) and on other systems the
+numbers are printed for comparison only: Wine runs the Windows calls but has
+no Windows memory manager, so a working-set trim does nothing there.
+
+Usage
+-----
+    python tests/windows_memory_check.py                  # all six runs, ~1-2 min
+    python tests/windows_memory_check.py --values 3000000 # smaller store
+    python tests/windows_memory_check.py --hold 30        # pause 30 s after each
+                                                          # flush to watch Task Manager
+    python tests/windows_memory_check.py --json result.json
+
+REVISION HISTORY
+----------------
+0.0.2  2026-10-26  Wine detected and reported as informational (no pass/fail).
+0.0.1  2026-10-26  First version (monitor 1.6.2).
+===============================================================================
+"""
+
+# %% IMPORTS ===================================================================
+from __future__ import annotations
+
+import argparse
+import gc
+import json
+import os
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE.parent))
+
+CONFIGS = {"gc_only": (0, 0), "heap_only": (1, 0), "full": (1, 1)}
+KEEPS = (0, 120)
+
+
+# %% MEMORY COUNTERS ===========================================================
+def memory_mb() -> dict:
+    """Working set and commit charge of this process in MiB.
+
+    Windows: K32GetProcessMemoryInfo with PROCESS_MEMORY_COUNTERS_EX (layout
+    as in psapi.h). Elsewhere: psutil rss / vms (for comparison only).
+    """
+    if sys.platform == "win32":
+        import ctypes
+        from ctypes import wintypes
+
+        class _Counters(ctypes.Structure):
+            _fields_ = [("cb", wintypes.DWORD), ("PageFaultCount", wintypes.DWORD),
+                        ("PeakWorkingSetSize", ctypes.c_size_t), ("WorkingSetSize", ctypes.c_size_t),
+                        ("QuotaPeakPagedPoolUsage", ctypes.c_size_t), ("QuotaPagedPoolUsage", ctypes.c_size_t),
+                        ("QuotaPeakNonPagedPoolUsage", ctypes.c_size_t),
+                        ("QuotaNonPagedPoolUsage", ctypes.c_size_t), ("PagefileUsage", ctypes.c_size_t),
+                        ("PeakPagefileUsage", ctypes.c_size_t), ("PrivateUsage", ctypes.c_size_t)]
+        k32 = ctypes.WinDLL("kernel32", use_last_error=True)
+        k32.GetCurrentProcess.restype = wintypes.HANDLE
+        k32.K32GetProcessMemoryInfo.argtypes = [wintypes.HANDLE, ctypes.c_void_p, wintypes.DWORD]
+        k32.K32GetProcessMemoryInfo.restype = wintypes.BOOL
+        counters = _Counters()
+        counters.cb = ctypes.sizeof(counters)
+        if not k32.K32GetProcessMemoryInfo(k32.GetCurrentProcess(), ctypes.byref(counters), counters.cb):
+            raise OSError(ctypes.get_last_error(), "K32GetProcessMemoryInfo failed")
+        # PrivateUsage is the commit charge; PagefileUsage holds the same value on
+        # Windows. Wine leaves PrivateUsage at 0, hence the fallback.
+        commit = counters.PrivateUsage or counters.PagefileUsage
+        return {"W": counters.WorkingSetSize / 2 ** 20, "C": commit / 2 ** 20, "source": "win32"}
+    import psutil
+    info = psutil.Process().memory_info()
+    return {"W": info.rss / 2 ** 20, "C": info.vms / 2 ** 20, "source": "psutil"}
+
+
+def running_under_wine() -> bool:
+    """True on Wine: its ntdll exports wine_get_version, Windows' does not."""
+    if sys.platform != "win32":
+        return False
+    try:
+        import ctypes
+        return hasattr(ctypes.WinDLL("ntdll"), "wine_get_version")
+    except OSError:
+        return False
+
+
+# %% ONE RUN (child process) =====================================================
+def run_one(config: str, keep: int, values: int, hold: float) -> dict:
+    """Fill the store, flush with one configuration, report the counters."""
+    import ab_power_meter_monitor as abm
+    abm.set_console_logging(False)
+    for flag in ("ENABLE_CSV", "ENABLE_LOG_APPEND", "ENABLE_VEUSZ", "ENABLE_FITS", "ENABLE_XLSX"):
+        setattr(abm, flag, 0)                         # no file output: the flush drops the rows
+    return_os, trim = CONFIGS[config]
+    gc.collect()
+    time.sleep(0.5)
+    idle = memory_mb()
+    tables, cols = 20, 60
+    rows = max(1, values // (tables * cols))
+    stamp = "2026-10-26 06:00:00"
+    # Filled in POLL order (row by row across every table), as the monitor
+    # allocates: the newest rows then sit together in the newest allocator
+    # arenas, so keep = 120 frees the older arenas as it would in a real run.
+    with abm._TS_LOCK:
+        tables_data = []
+        for t in range(tables):
+            columns = {f"P{c:02d}": [] for c in range(cols)}
+            abm.TIME_SERIES_STORE.setdefault(f"10.0.0.{t % 4}", {})[f"Table_{t:02d}"] = {
+                "timestamps_local": [], "columns": columns, "units": {name: "" for name in columns}}
+            tables_data.append(abm.TIME_SERIES_STORE[f"10.0.0.{t % 4}"][f"Table_{t:02d}"])
+        for r in range(rows):
+            for t, table in enumerate(tables_data):
+                table["timestamps_local"].append(stamp)
+                for c, column in enumerate(table["columns"].values()):
+                    column.append(float(r) + c / 100.0 + t)
+    filled = memory_mb()
+    cfg = abm.default_config()
+    cfg.update(mem_return_to_os=return_os, mem_trim_working_set=trim)
+    result = abm.perform_ram_flush(cfg, f"measure {config}", keep_samples=keep)
+    flushed = memory_mb()
+    if hold > 0:
+        print(f"  [{config}, keep {keep}] holding {hold:.0f} s - look at Task Manager (pid {os.getpid()})",
+              file=sys.stderr, flush=True)
+        time.sleep(hold)
+    else:
+        time.sleep(2.0)
+    later = memory_mb()
+    return {"config": config, "keep": keep, "values": tables * rows * cols, "pid": os.getpid(),
+            "idle": idle, "filled": filled, "flushed": flushed, "later": later,
+            "rows_removed": result["rows_removed"], "os_release": result["os_release_text"],
+            "monitor": abm.__version__}
+
+
+# %% DRIVER ========================================================================
+def judge(runs: list) -> list:
+    """Pass/fail lines (Windows); informational elsewhere."""
+    lines, by_key = [], {(r["config"], r["keep"]): r for r in runs}
+    for keep in KEEPS:
+        full = by_key.get(("full", keep))
+        if full:
+            added = full["filled"]["W"] - full["idle"]["W"]
+            limit = full["idle"]["W"] + 0.30 * added
+            ok = full["flushed"]["W"] <= limit
+            lines.append((ok, f"full, keep {keep}: W after flush {full['flushed']['W']:.0f} MiB "
+                              f"<= idle {full['idle']['W']:.0f} + 30 % of +{added:.0f} = {limit:.0f} MiB"))
+    full, gc_only = by_key.get(("full", 120)), by_key.get(("gc_only", 120))
+    if full and gc_only:
+        ok = full["flushed"]["W"] < gc_only["flushed"]["W"]
+        lines.append((ok, f"keep 120: W after flush full {full['flushed']['W']:.0f} MiB < gc_only "
+                          f"{gc_only['flushed']['W']:.0f} MiB"))
+    return lines
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    parser.add_argument("--values", type=int, default=6_000_000, help="float values in the store")
+    parser.add_argument("--hold", type=float, default=0.0, help="seconds to pause after each flush")
+    parser.add_argument("--json", default="", help="also write the results to this JSON file")
+    parser.add_argument("--one", nargs=2, metavar=("CONFIG", "KEEP"), help=argparse.SUPPRESS)
+    args = parser.parse_args()
+    if args.one:                                        # child process
+        print("RESULT " + json.dumps(run_one(args.one[0], int(args.one[1]), args.values, args.hold)),
+              flush=True)
+        return 0
+    runs = []
+    print(f"Python {sys.version.split()[0]} on {sys.platform}; {args.values:,} values per run")
+    print(f"{'config':10s} {'keep':>4s} | {'W idle':>7s} {'filled':>7s} {'flushed':>8s} {'+2 s':>6s} | "
+          f"{'C idle':>7s} {'filled':>7s} {'flushed':>8s} | OS release")
+    for keep in KEEPS:
+        for config in CONFIGS:
+            proc = subprocess.run([sys.executable, __file__, "--one", config, str(keep),
+                                   "--values", str(args.values), "--hold", str(args.hold)],
+                                  capture_output=True, text=True, timeout=900)
+            line = next((l for l in proc.stdout.splitlines() if l.startswith("RESULT ")), None)
+            if proc.returncode != 0 or line is None:
+                print(f"{config:10s} {keep:4d} | FAILED rc={proc.returncode}\n{proc.stderr[-1500:]}")
+                return 1
+            r = json.loads(line[7:])
+            runs.append(r)
+            print(f"{config:10s} {keep:4d} | {r['idle']['W']:7.0f} {r['filled']['W']:7.0f} "
+                  f"{r['flushed']['W']:8.0f} {r['later']['W']:6.0f} | {r['idle']['C']:7.0f} "
+                  f"{r['filled']['C']:7.0f} {r['flushed']['C']:8.0f} | {r['os_release']}")
+    source = runs[0]["idle"]["source"]
+    print(f"(MiB; W = working set, C = commit charge; counters from {source})")
+    verdicts = judge(runs)
+    wine = running_under_wine()
+    windows = sys.platform == "win32" and not wine
+    for ok, text in verdicts:
+        print((("PASS  " if ok else "FAIL  ") if windows else "INFO  ") + text)
+    if wine:
+        print("Wine: the Windows memory manager is not emulated - numbers for comparison only.")
+    elif not windows:
+        print("Not Windows: numbers are for comparison only (no pass/fail).")
+    if args.json:
+        Path(args.json).write_text(json.dumps({"runs": runs, "verdicts": verdicts, "judged": windows,
+                                               "wine": wine}, indent=2), encoding="utf-8")
+    all_ok = all(ok for ok, _ in verdicts)
+    print("PASS windows_memory_check" if (all_ok or not windows) else "FAIL windows_memory_check")
+    return 0 if (all_ok or not windows) else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
