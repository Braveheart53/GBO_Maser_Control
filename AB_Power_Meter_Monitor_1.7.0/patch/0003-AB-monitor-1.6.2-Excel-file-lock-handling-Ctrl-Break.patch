diff --git a/windows/_env.bat b/windows/_env.bat
new file mode 100644
index 0000000..98ba064
--- /dev/null
+++ b/windows/_env.bat
@@ -0,0 +1,28 @@
+@echo off
+rem =============================================================================
+rem  _env.bat - shared settings for the AB monitor Windows test kit
+rem  Version : 1.0.1   Created/Modified: 2026-10-26   Author: W. W. Wallace
+rem  Called by 2_ ... 5_*.bat (not meant to be run on its own). Sets:
+rem    KIT  this folder          APP  the program folder (KIT\app or KIT\..)
+rem    ENV  KIT\env              PY   the environment's python.exe
+rem  PATH is NOT changed (1.0.1): conda-forge Python 3.11+ adds its own bin,
+rem  Scripts and Library\bin folders to the DLL search path by itself, and a
+rem  monitor env first on PATH made Veusz (env_veusz) load the wrong HDF5/Qt.
+rem =============================================================================
+set "KIT=%~dp0"
+if "%KIT:~-1%"=="\" set "KIT=%KIT:~0,-1%"
+if exist "%KIT%\app\ab_power_meter_monitor.py" (set "APP=%KIT%\app") else (set "APP=%KIT%\..")
+set "ENV=%KIT%\env"
+set "PY="
+if exist "%ENV%\python.exe" set "PY=%ENV%\python.exe"
+if not defined PY if exist "%ENV%\Scripts\python.exe" set "PY=%ENV%\Scripts\python.exe"
+if not defined PY (
+    echo.
+    echo  The test environment is missing - run 1_setup_environment.bat first.
+    echo.
+    exit /b 1
+)
+set "PYTHONUTF8=1"
+set "PYTHONIOENCODING=utf-8"
+set "QT_API=pyside6"
+exit /b 0
diff --git a/windows/environment-veusz.txt b/windows/environment-veusz.txt
new file mode 100644
index 0000000..5b8c986
--- /dev/null
+++ b/windows/environment-veusz.txt
@@ -0,0 +1,11 @@
+# =============================================================================
+#  environment-veusz.txt - separate env for the Veusz 4.2.1 viewer (optional)
+#  Version : 1.0.1   Created/Modified: 2026-10-26   Author: W. W. Wallace
+#  Why separate: Veusz 4.2.1 needs PyQt6/Qt 6.8, which would hold PySide6 back
+#  to 6.8 in the monitor's environment. Only used to open/render .vszh5 files.
+#  1.0.1: + h5py - conda-forge's veusz does not depend on it, and without it
+#  Veusz cannot open .vszh5 ("No HDF5 support as h5py module is missing").
+# =============================================================================
+python=3.12
+veusz=4.2.1
+h5py=3.16.0
diff --git a/windows/environment-windows-test.txt b/windows/environment-windows-test.txt
new file mode 100644
index 0000000..e82b849
--- /dev/null
+++ b/windows/environment-windows-test.txt
@@ -0,0 +1,21 @@
+# =============================================================================
+#  environment-windows-test.txt - conda-forge win-64 specs for the AB monitor
+#  Version : 1.0.0   Created/Modified: 2026-10-26   Author: W. W. Wallace
+#  Use     : mamba create -y -p <kit>\env -c conda-forge --override-channels --file environment-windows-test.txt
+#            (1_setup_environment.bat does this). Same versions as the
+#            Windows-Python dry run (Wine) of 2026-10-26.
+# =============================================================================
+python=3.12.15
+requests=2.34.2
+beautifulsoup4=4.15.0
+lxml=6.1.3
+psutil=7.2.2
+prometheus_client=0.26.0
+numpy=2.5.4
+h5py=3.16.0
+astropy=8.0.2
+openpyxl=3.1.5
+pyside6=6.11.2
+qtpy=2.4.3
+matplotlib-base=3.11.2
+pypdf=6.21.2
