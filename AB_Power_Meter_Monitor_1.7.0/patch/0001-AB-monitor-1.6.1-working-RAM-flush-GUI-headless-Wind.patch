+# ===========================================================================
+# requirements-py312.txt - AB Power Meter toolset, Python 3.12 (PRIMARY TARGET)
+# ---------------------------------------------------------------------------
+# Version : 1.6.0 (matches ab_power_meter_monitor.py 1.6.0)   Modified: 2026-10-26
+# Lower bounds are the first releases that ship CPython 3.12 wheels; the
+# 1.6.0 test suite (tests/) passed on Python 3.12.3 with these exact versions:
+#   requests 2.34.2  beautifulsoup4 4.15.0  lxml 6.1.3  psutil 7.2.2
+#   prometheus-client 0.26.0  numpy 2.5.4  h5py 3.16.0  astropy 8.0.2
+#   openpyxl 3.1.5  PySide6 6.12.0  qtpy 2.4.3  matplotlib 3.11.2  pypdf 6.21.2
+#   (and Veusz 4.2.1 from conda-forge as the viewer / render check)
+#
+# Preferred install (mamba owns the interpreter, pip the packages):
+#   mamba create -n abmeter -c conda-forge python=3.12 pip
+#   mamba run -n abmeter pip install -r requirements-py312.txt
+# Pure conda-forge alternative: environment-conda.yml
+# ===========================================================================
+
+# -- Core: HTTP fetch + HTML parsing (always required) ----------------------
+requests>=2.31
+beautifulsoup4>=4.12
+lxml>=4.9.3
+
+# -- Memory protection (RAM / RSS figures for the flush triggers) ----------
+psutil>=5.9.6
+
+# -- Prometheus exporter ----------------------------------------------------
+prometheus_client>=0.19
+
+# -- Veusz .vszh5 output (native writer vszh5_writer.py; Veusz NOT needed) --
+numpy>=1.26
+h5py>=3.10
+
+# -- FITS output --------------------------------------------------------------
+astropy>=6.0
+
+# -- Excel output ---------------------------------------------------------------
+openpyxl>=3.1.2
+
+# -- GUI + previews (qtpy is the Qt abstraction layer the GUI imports) ----------
+PySide6>=6.6
+qtpy>=2.4
+matplotlib>=3.8
+
+# -- Optional: PDF bookmarks when rendering .vszh5 with vszh5_writer.render_pages
+pypdf>=4.0
