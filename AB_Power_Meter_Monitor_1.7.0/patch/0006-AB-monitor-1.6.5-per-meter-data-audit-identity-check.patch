+++ b/prototypes/pyqtgraph_live_preview.py
@@ -0,0 +1,428 @@
+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+# SPDX-License-Identifier: GPL-3.0-or-later
+# SPDX-FileCopyrightText: 2026 William W. Wallace <wwallace@nrao.edu>
+# %% ===========================================================================
+#    MODULE HEADER
+# =============================================================================
+"""Interactive live preview of the AB meters with pyqtgraph (prototype).
+
+===============================================================================
+ Title          : AB Power Meter live preview - pyqtgraph prototype
+ Filename       : prototypes/pyqtgraph_live_preview.py
+ Version        : 0.0.1 (Semantic Versioning 2.0.0, MAJOR.MINOR.PATCH)
+ Author         : William W. Wallace
+ Company        : NRAO/GBO
+ Email          : wwallace@nrao.edu   (alt: naval.antennas@gmail.com)
+ Created        : 2026-10-27
+ Modified       : 2026-10-27
+ Language       : Python 3.7.11+ (pyqtgraph 0.12.4) and 3.12 (pyqtgraph 0.14.0)
+ Requires       : ab_power_meter_monitor.py >= 1.6.5, PySide6 + qtpy, pyqtgraph,
+                  numpy
+ Licence        : GPL-3.0-or-later (GNU General Public License v3.0 or later)
+ Status         : Prototype - staged for the monitor GUI (see
+                  docs/plans/PLAN_1.7.0_pyqtgraph_and_meter_check.md)
+===============================================================================
+
+WHAT IT SHOWS
+-------------
+One tab per meter (IP address); in it one plot per UNIT with every parameter
+of that unit as a trace (the same grouping as the Grafana dashboard). The
+plots are pyqtgraph widgets, so they update in place every poll and are fully
+interactive while they update:
+
+  * crosshair: move the mouse over a plot - the local time and the value of
+    every trace at that time are shown in the plot's corner;
+  * zoom: mouse wheel (both axes) or right-drag (per axis); pan: left-drag;
+    the small "A" button or "Fit all" restores the full view;
+  * the time axes of one meter's plots are linked: zooming one zooms all;
+  * "Follow newest" keeps the right edge at the newest reading; any manual
+    zoom or pan switches it off so an update never moves the view under you.
+
+The data come from the monitor's own store (abm.store_snapshot(ip)) - the
+prototype polls through abm.poll_cycle() with every file output off, so it
+writes NO files and shows exactly what the monitor holds per meter.
+
+USAGE
+-----
+    python prototypes/pyqtgraph_live_preview.py --ips 10.16.130.50,10.16.130.54 --interval 30
+    python prototypes/pyqtgraph_live_preview.py --demo            # two emulated meters, 2 s
+    python prototypes/pyqtgraph_live_preview.py --demo --polls 6 --screenshot shot.png   # test
+
+REFERENCES
+----------
+[P1] pyqtgraph developers, "pyqtgraph documentation".
+     https://pyqtgraph.readthedocs.io/en/latest/
+[P2] pyqtgraph developers, "DateAxisItem".
+     https://pyqtgraph.readthedocs.io/en/latest/api_reference/graphicsItems/dateaxisitem.html
+[P3] pyqtgraph developers, "InfiniteLine".
+     https://pyqtgraph.readthedocs.io/en/latest/api_reference/graphicsItems/infiniteline.html
+
+REVISION HISTORY
+----------------
+0.0.1  2026-10-27  First prototype (monitor 1.6.5).
+===============================================================================
+"""
+
+# %% ===========================================================================
+#    IMPORTS
+# =============================================================================
+from __future__ import annotations
+
+import argparse
+import concurrent.futures
+import datetime
+import logging
+import os
+import sys
+import time
+from pathlib import Path
+from typing import Any, Dict, List, Optional, Tuple
+
+os.environ.setdefault("QT_API", "pyside6")           # qtpy and pyqtgraph pick the same binding
+HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE.parent))                 # the monitor lives one folder up
+
+import numpy as np  # noqa: E402
+from qtpy import QtCore, QtGui, QtWidgets  # noqa: E402
+import pyqtgraph as pg  # noqa: E402
+
+import ab_power_meter_monitor as abm  # noqa: E402
+
+__version__ = "0.0.1"
+
+# %% ===========================================================================
+#    SETTINGS
+# =============================================================================
+UNIT_ORDER = ["V", "A", "W", "VAR", "VA", "%", "Hz", "kWh", "kVARh", "kVAh", "s", "min", "ms"]
+UNIT_TITLE = {"V": "Voltage", "A": "Current", "W": "Real power", "VAR": "Reactive power",
+              "VA": "Apparent power", "%": "Percent", "Hz": "Frequency", "kWh": "Real energy",
+              "kVARh": "Reactive energy", "kVAh": "Apparent energy", "s": "Time", "min": "Time",
+              "ms": "Time"}
+#: Units pyqtgraph may scale with SI prefixes (33 000 W -> 33 kW); others stay as they are.
+SI_UNITS = {"V", "A", "W", "VAR", "VA", "Hz", "s"}
+#: Trace colours (colour-blind safe Tableau 10).
+COLOURS = ["#4e79a7", "#f28e2b", "#e15759", "#76b7b2", "#59a14f", "#edc948", "#b07aa1",
+           "#ff9da7", "#9c755f", "#bab0ac"]
+THEMES = {"dark": ("#1e1e2e", "#cdd6f4"), "light": ("#ffffff", "#202020")}
+MAX_POINTS = 20000                                   # per series fed to the plot (pyqtgraph decimates further)
+
+
+# %% ===========================================================================
+#    DATA: the monitor's store, grouped per meter and unit
+# =============================================================================
+def unit_groups(ip: str) -> Dict[str, List[Tuple[str, np.ndarray, np.ndarray]]]:
+    """{unit: [(label, unix_times, values)]} of one meter from abm.store_snapshot().
+
+    Parameters without a unit are left out (configuration numbers, status).
+    """
+    snap = abm.store_snapshot(ip=ip, max_points=MAX_POINTS).get(ip, {})
+    groups: Dict[str, List[Tuple[str, np.ndarray, np.ndarray]]] = {}
+    for tname in sorted(snap, key=abm._table_order):
+        table = snap[tname]
+        x = np.asarray(table["epoch_utc"], dtype=float)
+        for param, values in table["columns"].items():
+            unit = table["units"].get(param, "")
+            if not unit:
+                continue
+            y = np.array([np.nan if v is None else v for v in values], dtype=float)
+            groups.setdefault(unit, []).append((param, tname, x, y))
+    out: Dict[str, List[Tuple[str, np.ndarray, np.ndarray]]] = {}
+    for unit, items in groups.items():
+        names = [param for param, _t, _x, _y in items]
+        for param, tname, x, y in items:              # table only when the name repeats
+            label = param if names.count(param) == 1 else "{0} ({1})".format(
+                param, tname.replace("_Table", "").replace("_", " "))
+            out.setdefault(unit, []).append((label, x, y))
+    return out
+
+
+def ordered_units(units) -> List[str]:
+    """Known units in dashboard order, then the rest A-Z."""
+    return [u for u in UNIT_ORDER if u in units] + sorted(u for u in units if u not in UNIT_ORDER)
+
+
+# %% ===========================================================================
+#    ONE PLOT (one meter, one unit)
+# =============================================================================
+class UnitPlot(QtWidgets.QWidget):
+    """pyqtgraph plot of all traces of one unit, with crosshair read-out."""
+
+    manualRange = QtCore.Signal()
+
+    def __init__(self, ip: str, unit: str, theme: str) -> None:
+        super().__init__()
+        self.ip, self.unit = ip, unit
+        self.curves: Dict[str, Any] = {}
+        self.data: Dict[str, Tuple[np.ndarray, np.ndarray]] = {}
+        layout = QtWidgets.QVBoxLayout(self)
+        layout.setContentsMargins(0, 0, 0, 0)
+        self.widget = pg.PlotWidget(axisItems={"bottom": pg.DateAxisItem(orientation="bottom")})
+        self.widget.setMinimumHeight(280)
+        layout.addWidget(self.widget)
+        self.plot = self.widget.getPlotItem()
+        self.plot.setTitle("{0} [{1}] - {2}".format(UNIT_TITLE.get(unit, unit), unit, ip))
+        self.plot.showGrid(x=True, y=True, alpha=0.25)
+        self.plot.setLabel("left", UNIT_TITLE.get(unit, unit), units=unit)
+        self.plot.getAxis("left").enableAutoSIPrefix(unit in SI_UNITS)
+        self.legend = self.plot.addLegend(offset=(-10, 10), labelTextSize="8pt")
+        self.legend.setBrush(pg.mkBrush(30, 30, 46, 150))   # translucent: data stay visible
+        # Clicking a legend entry hides / shows that trace (pyqtgraph LegendItem).
+        # crosshair: two lines and a read-out text in the top-left corner
+        self.vline = pg.InfiniteLine(angle=90, movable=False, pen=pg.mkPen("#888888", style=QtCore.Qt.DashLine))
+        self.hline = pg.InfiniteLine(angle=0, movable=False, pen=pg.mkPen("#888888", style=QtCore.Qt.DashLine))
+        self.plot.addItem(self.vline, ignoreBounds=True)
+        self.plot.addItem(self.hline, ignoreBounds=True)
+        self.readout = pg.TextItem(anchor=(0, 0))
+        self.plot.addItem(self.readout, ignoreBounds=True)
+        self.readout.hide()
+        self._proxy = pg.SignalProxy(self.plot.scene().sigMouseMoved, rateLimit=30, slot=self._mouse_moved)
+        self.plot.getViewBox().sigRangeChangedManually.connect(lambda *_: self.manualRange.emit())
+        self.apply_theme(theme)
+
+    # --- data ------------------------------------------------------------------------
+    def update_traces(self, traces: List[Tuple[str, np.ndarray, np.ndarray]]) -> None:
+        """Create curves once, then only setData() - zoom and pan are kept."""
+        for index, (label, x, y) in enumerate(traces):
+            ok = np.isfinite(x)
+            x, y = x[ok], y[ok]
+            curve = self.curves.get(label)
+            if curve is None:
+                colour = COLOURS[len(self.curves) % len(COLOURS)]
+                curve = self.plot.plot([], [], name=label, pen=pg.mkPen(colour, width=1.6),
+                                       symbol="o", symbolSize=4, symbolBrush=colour, symbolPen=None)
+                curve.setDownsampling(auto=True, method="peak")
+                curve.setClipToView(True)
+                self.curves[label] = curve
+            curve.setData(x, y)
+            curve.setSymbol("o" if len(x) <= 200 else None)
+            self.data[label] = (x, y)
+
+    def newest_time(self) -> float:
+        return max((float(x[-1]) for x, _y in self.data.values() if len(x)), default=0.0)
+
+    # --- crosshair ---------------------------------------------------------------------
+    def _mouse_moved(self, event: Any) -> None:
+        pos = event[0]
+        if not self.plot.sceneBoundingRect().contains(pos):
+            self.readout.hide()
+            return
+        point = self.plot.getViewBox().mapSceneToView(pos)
+        self.show_readout(point.x(), point.y())
+
+    def show_readout(self, x: float, y: float) -> str:
+        """Move the crosshair to (x, y) and list every trace's value nearest to x."""
+        self.vline.setPos(x)
+        self.hline.setPos(y)
+        stamp = datetime.datetime.fromtimestamp(x).strftime("%Y-%m-%d %H:%M:%S") if x > 0 else "-"
+        lines = ["<b>{0}</b>".format(stamp)]
+        for label, (xs, ys) in self.data.items():
+            if not len(xs):
+                continue
+            i = int(np.clip(np.searchsorted(xs, x), 0, len(xs) - 1))
+            if i > 0 and abs(xs[i - 1] - x) < abs(xs[i] - x):
+                i -= 1
+            colour = self.curves[label].opts["pen"].color().name()
+            lines.append('<span style="color:{0}">{1}: {2:.6g} {3}</span>'.format(colour, label, ys[i], self.unit))
+        html = "<br>".join(lines)
+        self.readout.setHtml('<div style="background-color:rgba(0,0,0,110);padding:3px">{0}</div>'.format(html))
+        view = self.plot.getViewBox().viewRange()
+        self.readout.setPos(view[0][0], view[1][1])
+        self.readout.show()
+        return html
+
+    # --- look --------------------------------------------------------------------------
+    def apply_theme(self, theme: str) -> None:
+        background, foreground = THEMES[theme]
+        self.widget.setBackground(background)
+        for name in ("left", "bottom"):
+            axis = self.plot.getAxis(name)
+            axis.setPen(foreground)
+            axis.setTextPen(foreground)
+        self.plot.setTitle(self.plot.titleLabel.text, color=foreground)
+        self.readout.setColor(foreground)
+
+
+# %% ===========================================================================
+#    MAIN WINDOW
+# =============================================================================
+class PreviewWindow(QtWidgets.QMainWindow):
+    """Tabs per meter, plots per unit, polling in a worker thread."""
+
+    def __init__(self, ips: List[str], interval: float, theme: str = "dark") -> None:
+        super().__init__()
+        self.setWindowTitle("AB meters - live preview (pyqtgraph prototype {0})".format(__version__))
+        self.resize(1300, 900)
+        self.ips, self.interval, self.theme = ips, float(interval), theme
+        self.cfg = abm.default_config()
+        self.cfg["ip_list"] = list(ips)
+        for key in ("enable_csv", "enable_log_append", "enable_veusz", "enable_fits", "enable_xlsx",
+                    "enable_log_file", "enable_ram_flush"):
+            self.cfg[key] = 0                                    # no files at all
+        self.pool = concurrent.futures.ThreadPoolExecutor(max_workers=1, thread_name_prefix="preview_poll")
+        self.future: Optional[concurrent.futures.Future] = None
+        self.polls = 0
+        #: width of the "Follow newest" time window (s): 20 polls, at least 2 min;
+        #: taken over from the view when follow is switched back on.
+        self.window_s = max(120.0, 20.0 * self.interval)
+        self.plots: Dict[Tuple[str, str], UnitPlot] = {}
+        self.columns: Dict[str, QtWidgets.QVBoxLayout] = {}
+        self.follow = QtWidgets.QCheckBox("Follow newest")
+        self.follow.setChecked(True)
+        self.follow.toggled.connect(self._follow_toggled)
+        fit = QtWidgets.QPushButton("Fit all")
+        fit.clicked.connect(self._fit_all)
+        bar = QtWidgets.QToolBar("View")
+        bar.addWidget(self.follow)
+        bar.addWidget(fit)
+        self.addToolBar(bar)
+        self.tabs = QtWidgets.QTabWidget()
+        self.setCentralWidget(self.tabs)
+        for ip in ips:
+            page = QtWidgets.QWidget()
+            column = QtWidgets.QVBoxLayout(page)
+            column.addStretch(1)
+            scroller = QtWidgets.QScrollArea()
+            scroller.setWidgetResizable(True)
+            scroller.setWidget(page)
+            self.tabs.addTab(scroller, "Meter {0}".format(ip))
+            self.columns[ip] = column
+        menu = self.menuBar().addMenu("&View")
+        for name in ("dark", "light"):
+            action = menu.addAction("{0} theme".format(name.title()))
+            action.triggered.connect(lambda _c=False, _n=name: self._set_theme(_n))
+        self.status = self.statusBar()
+        abm.begin_run(self.cfg)
+        self.poll_timer = QtCore.QTimer(self)
+        self.poll_timer.timeout.connect(self._start_poll)
+        self.poll_timer.start(int(self.interval * 1000))
+        self.check_timer = QtCore.QTimer(self)
+        self.check_timer.timeout.connect(self._check_poll)
+        self.check_timer.start(200)
+        self._start_poll()
+
+    # --- polling (worker thread) ----------------------------------------------------------
+    def _start_poll(self) -> None:
+        if self.future is None or self.future.done():
+            self.future = self.pool.submit(abm.poll_cycle, self.cfg)
+
+    def _check_poll(self) -> None:
+        if self.future is None or not self.future.done():
+            return
+        future, self.future = self.future, None
+        try:
+            result = future.result()
+        except Exception as exc:                                 # shown, never fatal
+            self.status.showMessage("Poll failed: {0}".format(exc))
+            return
+        self.polls += 1
+        self._refresh()
+        self.status.showMessage("Poll {0} at {1}: {2:.1f} s, answering {3}, no answer {4}".format(
+            self.polls, time.strftime("%H:%M:%S"), result["poll_seconds"], ", ".join(result["ok_ips"]) or "-",
+            ", ".join(result["failed_ips"]) or "-"))
+
+    # --- plots ----------------------------------------------------------------------------
+    def _refresh(self) -> None:
+        for ip in self.ips:
+            groups = unit_groups(ip)
+            first = None
+            for unit in ordered_units(groups):
+                plot = self.plots.get((ip, unit))
+                if plot is None:
+                    plot = UnitPlot(ip, unit, self.theme)
+                    plot.manualRange.connect(lambda: self.follow.setChecked(False))   # user zoom wins
+                    column = self.columns[ip]
+                    column.insertWidget(column.count() - 1, plot)
+                    self.plots[(ip, unit)] = plot
+                    if first is not None:
+                        plot.plot.setXLink(first.plot)           # one meter: zoom in time together
+                first = first or plot
+                plot.update_traces(groups[unit])
+            if self.follow.isChecked() and first is not None:
+                newest = max(p.newest_time() for (i, _u), p in self.plots.items() if i == ip)
+                first.plot.setXRange(newest - self.window_s, newest, padding=0.02)
+                for (i, _u), p in self.plots.items():
+                    if i == ip:
+                        p.plot.enableAutoRange(axis="y")
+
+    def _follow_toggled(self, on: bool) -> None:
+        """Switching follow back on keeps the time width the user zoomed to."""
+        if not on:
+            return
+        widths = [p.plot.getViewBox().viewRange()[0] for p in self.plots.values()]
+        widths = [r - l for l, r in widths if 10.0 < r - l < 31 * 86400]
+        if widths:
+            self.window_s = max(widths)
+        self._refresh()
+
+    def _fit_all(self) -> None:
+        for plot in self.plots.values():
+            plot.plot.autoRange()
+
+    def _set_theme(self, theme: str) -> None:
+        self.theme = theme
+        for plot in self.plots.values():
+            plot.apply_theme(theme)
+
+    def closeEvent(self, event: Any) -> None:  # noqa: N802 - Qt interface
+        self.poll_timer.stop()
+        self.check_timer.stop()
+        self.pool.shutdown(wait=True)
+        abm.end_run(self.cfg)
+        super().closeEvent(event)
+
+
+# %% ===========================================================================
+#    COMMAND LINE
+# =============================================================================
+def main(argv: Optional[List[str]] = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    parser.add_argument("--ips", help="meters (default: the monitor's IP_LIST)")
+    parser.add_argument("--url-template", dest="url_template")
+    parser.add_argument("--interval", type=float, default=30.0, help="seconds between polls")
+    parser.add_argument("--demo", action="store_true", help="start two emulated meters (127.0.0.2/.3) and poll every 2 s")
+    parser.add_argument("--theme", choices=["dark", "light"], default="dark")
+    parser.add_argument("--polls", type=int, default=0, help="test: quit after this many polls")
+    parser.add_argument("--screenshot", help="test: save the window after --polls polls")
+    args = parser.parse_args(argv)
+    logging.getLogger("ABMonitor").setLevel(logging.WARNING)
+    abm.set_console_logging(False)
+    ips = [ip.strip() for ip in args.ips.split(",")] if args.ips else list(abm.IP_LIST)
+    interval = args.interval
+    if args.demo:
+        sys.path.insert(0, str(HERE.parent / "tests"))
+        from ab_meter_emulator import start_emulators
+        port = 18099
+        ips = ["127.0.0.2", "127.0.0.3"]
+        start_emulators(ips, port)
+        abm.METER_URL_TEMPLATE = "http://{ip}:%d/{page}" % port
+        interval = min(interval, 2.0)
+    if args.url_template:
+        abm.METER_URL_TEMPLATE = args.url_template
+    app = QtWidgets.QApplication.instance() or QtWidgets.QApplication(sys.argv)
+    pg.setConfigOptions(antialias=True)
+    window = PreviewWindow(ips, interval, args.theme)
+    window.show()
+    if args.polls:
+        def _watch() -> None:
+            if window.polls < args.polls:
+                return
+            first = next((p for (ip, u), p in window.plots.items() if u == "A"), None)
+            if first is not None:                           # show the crosshair read-out
+                xs = [x for x, _y in first.data.values()][0]
+                first.show_readout(float(xs[len(xs) // 2]), float(np.nanmean(list(first.data.values())[0][1])))
+            app.processEvents()
+            if args.screenshot:
+                window.grab().save(args.screenshot)
+            window.close()
+            app.quit()
+        watcher = QtCore.QTimer()
+        watcher.timeout.connect(_watch)
+        watcher.start(250)
+        app.exec_() if hasattr(app, "exec_") else app.exec()
+        return 0
+    return app.exec_() if hasattr(app, "exec_") else app.exec()
+
+
+if __name__ == "__main__":
+    sys.exit(main())
