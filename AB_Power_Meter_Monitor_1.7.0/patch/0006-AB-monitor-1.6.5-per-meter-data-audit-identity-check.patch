+# %% ===========================================================================
+#    METER IDENTITY: the address a meter reports for itself (1.6.5)
+# =============================================================================
+_REPORTED_IP_RE = re.compile(r"^ip\s*address\D*([1-4])$")
+_IDENTITY_WARNED: Dict[str, float] = {}           # ip -> monotonic time of last warning
+_IDENTITY_LOCK = threading.Lock()
+
+
+def reported_ip(table_dict: Dict[str, Any]) -> Optional[str]:
+    """Dotted address a meter lists on its Communications page, else None.
+
+    Parameters named "IP Address Octet 1" ... "4" (or "IP Address 1" ... "4")
+    are combined when all four are integers 0-255. Other names (gateway,
+    subnet mask) are ignored; a meter that does not list its address gives None.
+    """
+    octets: Dict[int, int] = {}
+    for key, name in table_dict.items():
+        if not isinstance(key, str) or key.startswith("_") or key.endswith(("_value", "_unit")):
+            continue
+        match = _REPORTED_IP_RE.match(str(name).strip().lower())
+        if not match:
+            continue
+        value = table_dict.get(key + "_value")
+        if isinstance(value, bool) or not isinstance(value, (int, float)):
+            continue
+        if value == int(value) and 0 <= value <= 255:
+            octets[int(match.group(1))] = int(value)
+    if sorted(octets) != [1, 2, 3, 4]:
+        return None
+    return ".".join(str(octets[i]) for i in (1, 2, 3, 4))
+
+
+def _check_reported_ip(ip: str, table_dict: Dict[str, Any]) -> Optional[str]:
+    """Warn (rate-limited) when the meter polled at ``ip`` reports another address.
+
+    Returns the reported address (None if the page does not list it). When
+    the meters are reached through port forwarding or a proxy, a mismatch is
+    expected; the warning says so.
+    """
+    reported = reported_ip(table_dict)
+    if reported is None or reported == ip or not re.match(r"^\d+\.\d+\.\d+\.\d+$", ip):
+        return reported
+    now = time.monotonic()
+    with _IDENTITY_LOCK:
+        last = _IDENTITY_WARNED.get(ip)
+        if last is not None and now - last < 600.0:
+            return reported
+        _IDENTITY_WARNED[ip] = now
+    logger.warning("Meter polled at %s reports its address as %s - the data filed under %s may come "
+                   "from another meter (duplicate address, NAT or proxy). Expected only when the "
+                   "meters are reached through port forwarding.", ip, reported, ip)
+    return reported
+
+
