+# %% ===========================================================================
+#    LIVE PLOT DATA (1.7.0) - Qt-free; drawn by ab_live_plots.py (pyqtgraph)
+# =============================================================================
+# The interactive GUI shows ONE TAB PER METER. Its plots come from
+# preview_groups(ip, view): every list is copied briefly under the store lock,
+# converted to numpy and decimated outside it. Nothing here imports Qt, so the
+# grouping is tested on headless hosts too (tests/test_live_plots.py).
+
+#: Plot order of the known units in the "unit" view (then the rest A-Z).
+LIVE_UNIT_ORDER: List[str] = ["V", "A", "W", "VAR", "VA", "%", "Hz", "kWh", "kVARh", "kVAh",
+                              "s", "min", "ms"]
+#: Plot titles of the known units.
+LIVE_UNIT_TITLE: Dict[str, str] = {
+    "V": "Voltage", "A": "Current", "W": "Real power", "VAR": "Reactive power",
+    "VA": "Apparent power", "%": "Power factor / percent", "Hz": "Frequency",
+    "kWh": "Real energy", "kVARh": "Reactive energy", "kVAh": "Apparent energy",
+    "s": "Time", "min": "Time", "ms": "Time"}
+#: The views a meter tab offers: one plot per unit, per table (and unit), per overlay group.
+PREVIEW_VIEWS: Tuple[str, ...] = ("unit", "table", "overlay")
+
+
+def _unit_rank(unit: str) -> Tuple[int, str]:
+    """Sort key: LIVE_UNIT_ORDER first, other units A-Z, no unit last."""
+    if unit in LIVE_UNIT_ORDER:
+        return (LIVE_UNIT_ORDER.index(unit), unit)
+    return (len(LIVE_UNIT_ORDER) + (1 if not unit else 0), unit)
+
+
+def _float_array(values: Sequence[Any]) -> Any:
+    """float64 array of a store column; None (and anything non-numeric) -> NaN."""
+    try:
+        return np.array(values, dtype=float)          # numpy turns None into NaN
+    except (TypeError, ValueError):                   # a text value slipped into the column
+        out = np.full(len(values), np.nan)
+        for index, value in enumerate(values):
+            if isinstance(value, (int, float)) and not isinstance(value, bool):
+                out[index] = value
+        return out
+
+
+def _insert_gaps(x: Any, y: Any, factor: float) -> Tuple[Any, Any]:
+    """Insert a NaN point where the time step exceeds ``factor`` x the median step.
+
+    The plot then shows an outage as a gap instead of a straight line (the
+    curve is drawn with connect="finite"). factor <= 0 disables it.
+    """
+    if factor <= 0 or len(x) < 3:
+        return x, y
+    steps = np.diff(x)
+    median = float(np.median(steps[np.isfinite(steps)])) if np.isfinite(steps).any() else 0.0
+    if median <= 0:
+        return x, y
+    where = np.nonzero(steps > factor * median)[0]
+    if not len(where):
+        return x, y
+    middle = (x[where] + x[where + 1]) / 2.0
+    return np.insert(x, where + 1, middle), np.insert(y, where + 1, np.nan)
+
+
+def preview_meter_ips(ip_order: Optional[Sequence[str]] = None) -> List[str]:
+    """Meters that have rows in the store: those of ``ip_order`` first, then the rest."""
+    with _TS_LOCK:
+        have = [ip for ip, tables in TIME_SERIES_STORE.items()
+                if any(t.get("timestamps_local") for t in tables.values())]
+    return dedupe_ips([ip for ip in (ip_order or IP_LIST) if ip in have] + have)
+
+
+def preview_groups(ip: str, view: str = "unit", max_points: Optional[int] = None,
+                   gap_factor: Optional[float] = None) -> List[Dict[str, Any]]:
+    """Plots of ONE meter for the interactive GUI.
+
+    Parameters
+    ----------
+    ip : str
+        The meter; only TIME_SERIES_STORE[ip] is read, never another meter.
+    view : {"unit", "table", "overlay"}
+        "unit": one plot per unit with every parameter of that unit (as the
+        Grafana dashboard); parameters without a unit are left out.
+        "table": one plot per table and unit (parameters without a unit get
+        their own plot). "overlay": one plot per VEUSZ_OVERLAY_GROUPS entry.
+    max_points : int, optional
+        Points per trace (default LIVE_PLOT_MAX_POINTS); longer series are
+        min/max decimated, so spikes survive.
+    gap_factor : float, optional
+        See _insert_gaps (default LIVE_PLOT_GAP_FACTOR).
+
+    Returns
+    -------
+    list of dict
+        [{"key": tuple, "title": str, "unit": str,
+          "traces": [(label, unix_times, values), ...]}] in display order.
+        Values are float64 copies of the stored samples (NaN = missing).
+    """
+    if view not in PREVIEW_VIEWS:
+        raise ValueError("view must be one of {0}".format(PREVIEW_VIEWS))
+    max_points = LIVE_PLOT_MAX_POINTS if max_points is None else int(max_points)
+    gap_factor = LIVE_PLOT_GAP_FACTOR if gap_factor is None else float(gap_factor)
+    raw: List[Tuple[str, List[float], Dict[str, List[Any]], Dict[str, str]]] = []
+    with _TS_LOCK:                                    # list copies only; no numpy under the lock
+        for tname, tstore in TIME_SERIES_STORE.get(ip, {}).items():
+            if not tstore.get("timestamps_local") or not tstore.get("columns"):
+                continue
+            raw.append((tname, list(_aligned_meta(ip, tname, tstore)["epoch"]),
+                        {p: list(v) for p, v in tstore["columns"].items()}, dict(tstore["units"])))
+    raw.sort(key=lambda item: _table_order(item[0]))
+    # (table, param, unit, x, y) for every parameter, decimated per trace
+    items: List[Tuple[str, str, str, Any, Any]] = []
+    for tname, epochs, columns, units in raw:
+        x_full = np.asarray(epochs, dtype=float)
+        for param, values in columns.items():
+            y = _float_array(values)
+            x = x_full
+            if max_points and len(x) > max_points:
+                x, y = _minmax_decimate(x, y, max_points)
+            items.append((tname, param, units.get(param, ""), x, y))
+    groups: Dict[Tuple[Any, ...], Dict[str, Any]] = {}
+    for tname, param, unit, x, y in items:
+        if view == "unit":
+            if not unit:
+                continue
+            key: Tuple[Any, ...] = ("unit", unit)
+            title = "{0} [{1}]".format(LIVE_UNIT_TITLE.get(unit, unit), unit)
+        elif view == "table":
+            key = ("table", tname, unit)
+            title = "{0} - {1}".format(tname.replace("_Table", "").replace("_", " "),
+                                       "[{0}]".format(unit) if unit else "no unit")
+        else:
+            group = next((g for g, subs in VEUSZ_OVERLAY_GROUPS.items()
+                          if any(s in param.lower() for s in subs)), None)
+            if group is None:
+                continue
+            key, title = ("overlay", group), group
+        entry = groups.setdefault(key, {"key": key, "title": title, "unit": unit, "items": []})
+        entry["items"].append((tname, param, x, y))
+    if view == "unit":
+        order = sorted(groups, key=lambda k: _unit_rank(k[1]))
+    elif view == "table":
+        order = sorted(groups, key=lambda k: (_table_order(k[1]), _unit_rank(k[2])))
+    else:
+        names = list(VEUSZ_OVERLAY_GROUPS)
+        order = sorted(groups, key=lambda k: names.index(k[1]))
+    out: List[Dict[str, Any]] = []
+    for key in order:
+        entry = groups[key]
+        names = [param for _t, param, _x, _y in entry["items"]]
+        traces = []
+        gapped: Dict[int, Any] = {}                   # x shared by a table's traces: gap it once
+        for tname, param, x, y in entry["items"]:
+            label = param if names.count(param) == 1 else "{0} ({1})".format(
+                param, tname.replace("_Table", "").replace("_", " "))
+            if id(x) not in gapped:
+                gapped[id(x)] = _insert_gaps(x, np.zeros(len(x)), gap_factor)[0]
+            xg = gapped[id(x)]
+            yg = y if len(xg) == len(x) else _insert_gaps(x, y, gap_factor)[1]
+            traces.append((label, xg, yg))
+        out.append({"key": key, "title": entry["title"], "unit": entry["unit"], "traces": traces})
+    return out
+
+
+def meter_identity(ip: str) -> Dict[str, Any]:
+    """What the meter polled at ``ip`` says about itself, and what is in memory.
+
+    Returns {"ip", "reported_ip" (None if page 1 does not list it), "matches"
+    (False only when the meter reports ANOTHER address), "serial", "catalog",
+    "rows" (most rows of any table in memory), "newest_epoch" (or None)}.
+    """
+    tables = all_device_data_snapshot().get(ip, {})
+
+    def _text(table: str, word: str) -> Optional[str]:
+        page = tables.get(table) or {}
+        for key, name in page.items():
+            if (isinstance(key, str) and not key.startswith("_") and not key.endswith(("_value", "_unit"))
+                    and word in str(name).lower()):
+                value = page.get(key + "_value")
+                return None if value is None else str(value)
+        return None
+
+    reported = reported_ip(tables.get("Communications_Configuration_Table") or {})
+    rows, newest = 0, None
+    with _TS_LOCK:
+        for tname, tstore in TIME_SERIES_STORE.get(ip, {}).items():
+            n_rows = len(tstore.get("timestamps_local", []))
+            rows = max(rows, n_rows)
+            if n_rows:
+                epoch = _aligned_meta(ip, tname, tstore)["epoch"][-1]
+                if epoch == epoch and (newest is None or epoch > newest):     # not NaN
+                    newest = float(epoch)
+    return {"ip": ip, "reported_ip": reported, "matches": reported is None or reported == ip,
+            "serial": _text("Device_Configuration_Table", "serial"),
+            "catalog": _text("Device_Configuration_Table", "catalog"),
+            "rows": rows, "newest_epoch": newest}
+
