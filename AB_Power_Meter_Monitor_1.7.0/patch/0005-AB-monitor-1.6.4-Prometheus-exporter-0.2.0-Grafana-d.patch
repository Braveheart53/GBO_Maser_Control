new file mode 100644
index 0000000..f2b637b
--- /dev/null
+++ b/monitoring/grafana/provisioning/datasources/ab_prometheus.yaml
@@ -0,0 +1,22 @@
+# =============================================================================
+#  ab_prometheus.yaml - Grafana data source provisioning (Prometheus)
+#  Version : 0.0.1   Created/Modified: 2026-10-27   Author: W. W. Wallace
+#  Copy to : <Grafana>/conf/provisioning/datasources/   (Linux packages:
+#            /etc/grafana/provisioning/datasources/) and restart Grafana.
+#  The dashboard selects this data source by uid "ab-prometheus"; it also has
+#  a "Data source" drop-down, so an existing Prometheus data source works too
+#  (then this file is not needed).
+# =============================================================================
+apiVersion: 1
+
+datasources:
+  - name: Prometheus (AB meters)
+    uid: ab-prometheus
+    type: prometheus
+    access: proxy
+    url: http://localhost:9090        # your Prometheus server
+    isDefault: false                  # leave an existing default data source alone
+    editable: true
+    jsonData:
+      timeInterval: 30s               # = the scrape interval of the meter job
+      httpMethod: POST
diff --git a/monitoring/prometheus/prometheus.yml b/monitoring/prometheus/prometheus.yml
new file mode 100644
index 0000000..bedd5ea
--- /dev/null
+++ b/monitoring/prometheus/prometheus.yml
@@ -0,0 +1,31 @@
+# =============================================================================
+#  prometheus.yml - Prometheus configuration for the AB power meters
+#  Version : 0.0.1   Created/Modified: 2026-10-27   Author: W. W. Wallace
+#  Use     : a complete file for a dedicated Prometheus, or copy the two jobs
+#            under scrape_configs into an existing prometheus.yml.
+#  Tested  : Prometheus 3.5.0 (promtool check config), Pushgateway 1.11.1.
+# -----------------------------------------------------------------------------
+#  ab_power_meter : CONTINUOUS exporter - Prometheus pulls its /metrics.
+#                   scrape_interval = the exporter's --interval (30 s default),
+#                   so every scrape sees a new reading.
+#  pushgateway    : SINGLE RUNS (ab_prometheus_exporter.py --once
+#                   --push-gateway ...) push here; honor_labels keeps the
+#                   pushed job="ab_power_meter" and instance=<host> labels, so
+#                   the same dashboard shows pulled and pushed data.
+# =============================================================================
+global:
+  scrape_interval: 30s
+  evaluation_interval: 30s
+
+scrape_configs:
+  - job_name: ab_power_meter
+    scrape_interval: 30s            # = ab_prometheus_exporter.py --interval
+    scrape_timeout: 10s             # a scrape never waits for the meters
+    static_configs:
+      - targets: ["localhost:9184"] # host:port of the exporter (--port)
+
+  - job_name: pushgateway
+    honor_labels: true              # keep job/instance labels of the pushed group
+    scrape_interval: 15s
+    static_configs:
+      - targets: ["localhost:9091"] # host:port of the Pushgateway
diff --git a/monitoring/systemd/ab-exporter-once.service b/monitoring/systemd/ab-exporter-once.service
new file mode 100644
index 0000000..cdc1b65
--- /dev/null
+++ b/monitoring/systemd/ab-exporter-once.service
@@ -0,0 +1,29 @@
+# =============================================================================
+#  ab-exporter-once.service - ONE poll of the AB meters, pushed to a Pushgateway
+#  Version : 0.0.2   Created: 2026-10-27   Modified: 2026-10-27   Author: W. W. Wallace
+#  Template rendered by install.sh --once-timer (__PLACEHOLDERS__ are filled in);
+#  to install by hand, replace them yourself:
+#    __PYTHON__        interpreter, e.g. /opt/abmeter/env/bin/python (Python 3.7 env)
+#    __INSTALL_DIR__   e.g. /opt/abmeter
+#    __IPS__           e.g. 10.16.130.50,10.16.130.54
+#    __PUSH_GATEWAY__  e.g. http://localhost:9091
+#    __USER_LINE__     User=abmeter   (empty for a per-user unit)
+#  Started by ab-exporter-once.timer (single-run mode). Writes no files.
+#  For CONTINUOUS operation use ab-exporter.service (repository root) instead.
+#  0.0.2: template for install.sh; SELinux/RHEL 9 notes in README_monitoring.md.
+# =============================================================================
+[Unit]
+Description=AB power meters - single poll pushed to the Pushgateway
+After=network-online.target
+Wants=network-online.target
+
+[Service]
+Type=oneshot
+__USER_LINE__
+WorkingDirectory=__INSTALL_DIR__
+ExecStart=__PYTHON__ __INSTALL_DIR__/ab_prometheus_exporter.py --once --ips __IPS__ --push-gateway __PUSH_GATEWAY__
+# Exit 1 = no meter answered (the dashboard shows it): not a unit failure.
+# Exit 2 = the push failed: the unit fails and shows in systemctl --failed.
+SuccessExitStatus=1
+TimeoutStartSec=240
+Nice=5
diff --git a/monitoring/systemd/ab-exporter-once.timer b/monitoring/systemd/ab-exporter-once.timer
new file mode 100644
index 0000000..c36c908
--- /dev/null
+++ b/monitoring/systemd/ab-exporter-once.timer
@@ -0,0 +1,20 @@
+# =============================================================================
+#  ab-exporter-once.timer - run ab-exporter-once.service on a schedule
+#  Version : 0.0.2   Created: 2026-10-27   Modified: 2026-10-27   Author: W. W. Wallace
+#  Template rendered by install.sh --once-timer --once-period N (default 60 s);
+#  by hand, replace __ONCE_PERIOD__ with the period in seconds.
+#  Build the dashboard with the same period (ab_grafana_dashboard.py
+#  --interval N) so "Seconds since last poll" and "Meter answering" turn red
+#  when the runs stop.
+# =============================================================================
+[Unit]
+Description=AB power meters - single poll every __ONCE_PERIOD__ s
+
+[Timer]
+OnBootSec=60
+OnUnitActiveSec=__ONCE_PERIOD__
+AccuracySec=5
+Unit=ab-exporter-once.service
+
+[Install]
+WantedBy=timers.target
diff --git a/monitoring/systemd/prometheus.service b/monitoring/systemd/prometheus.service
new file mode 100644
index 0000000..5dda44c
--- /dev/null
+++ b/monitoring/systemd/prometheus.service
@@ -0,0 +1,35 @@
+# =============================================================================
+#  prometheus.service - Prometheus server for the AB power meters (example)
+#  Version : 0.0.1   Created/Modified: 2026-10-27   Author: W. W. Wallace
+#  Only needed when no Prometheus exists yet. RHEL 9, official release:
+#    tar xzf prometheus-3.5.0.linux-amd64.tar.gz
+#    install -m 0755 prometheus-3.5.0.linux-amd64/{prometheus,promtool} /usr/local/bin/
+#    useradd --system --no-create-home --shell /usr/sbin/nologin prometheus
+#    install -d -o prometheus -g prometheus /etc/prometheus
+#    cp monitoring/prometheus/prometheus.yml /etc/prometheus/   # edit the targets
+#    promtool check config /etc/prometheus/prometheus.yml
+#    restorecon -Rv /usr/local/bin /etc/prometheus             # SELinux labels
+#    cp prometheus.service /etc/systemd/system/ && systemctl daemon-reload
+#    systemctl enable --now prometheus
+#    firewall-cmd --permanent --add-port=9090/tcp && firewall-cmd --reload   # only if
+#      Grafana runs on another host
+#  Reload the configuration without a restart: systemctl reload prometheus
+# =============================================================================
+[Unit]
+Description=Prometheus server (AB power meters)
+After=network-online.target
+Wants=network-online.target
+
+[Service]
+Type=simple
+User=prometheus
+StateDirectory=prometheus
+ExecStart=/usr/local/bin/prometheus --config.file=/etc/prometheus/prometheus.yml \
+          --storage.tsdb.path=/var/lib/prometheus --storage.tsdb.retention.time=400d \
+          --web.listen-address=:9090
+ExecReload=/bin/kill -HUP $MAINPID
+Restart=on-failure
+RestartSec=10
+
+[Install]
+WantedBy=multi-user.target
diff --git a/monitoring/systemd/pushgateway.service b/monitoring/systemd/pushgateway.service
new file mode 100644
index 0000000..68a2b6a
--- /dev/null
+++ b/monitoring/systemd/pushgateway.service
@@ -0,0 +1,31 @@
+# =============================================================================
+#  pushgateway.service - Prometheus Pushgateway for the single-run mode
+#  Version : 0.0.1   Created/Modified: 2026-10-27   Author: W. W. Wallace
+#  RHEL 9 (no RPM in the base repositories): install the official release
+#    tar xzf pushgateway-1.11.1.linux-amd64.tar.gz
+#    install -m 0755 pushgateway-1.11.1.linux-amd64/pushgateway /usr/local/bin/
+#    useradd --system --no-create-home --shell /usr/sbin/nologin pushgateway
+#    restorecon -v /usr/local/bin/pushgateway                  # SELinux: bin_t
+#    cp pushgateway.service /etc/systemd/system/ && systemctl daemon-reload
+#    systemctl enable --now pushgateway
+#    firewall-cmd --permanent --add-port=9091/tcp && firewall-cmd --reload   # only if
+#      the exporter runs on another host than the Pushgateway
+#  The pushed values live in memory; --persistence.file keeps them across a
+#  restart (a file in /var/lib/pushgateway).
+# =============================================================================
+[Unit]
+Description=Prometheus Pushgateway (AB power meters, single runs)
+After=network-online.target
+Wants=network-online.target
+
+[Service]
+Type=simple
+User=pushgateway
+StateDirectory=pushgateway
+ExecStart=/usr/local/bin/pushgateway --web.listen-address=:9091 \
+          --persistence.file=/var/lib/pushgateway/metrics.store --persistence.interval=5m
+Restart=on-failure
+RestartSec=10
+
+[Install]
+WantedBy=multi-user.target
