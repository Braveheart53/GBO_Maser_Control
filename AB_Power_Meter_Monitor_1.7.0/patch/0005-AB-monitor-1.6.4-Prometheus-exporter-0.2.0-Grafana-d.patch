diff --git a/docs/tools/README_pdf.sh b/docs/tools/README_pdf.sh
index 95fab58..e688365 100755
--- a/docs/tools/README_pdf.sh
+++ b/docs/tools/README_pdf.sh
@@ -1,7 +1,7 @@
 #!/usr/bin/env bash
 # =============================================================================
 #  README_pdf.sh - render README.md to the bookmarked README.pdf (LuaLaTeX)
-#  Version : 1.0.2   Created/Modified: 2026-10-27   Author: W. W. Wallace
+#  Version : 1.0.3   Created/Modified: 2026-10-27   Author: W. W. Wallace
 #  Needs   : pandoc >= 3, LuaLaTeX (TeX Live), DejaVu fonts, fvextra, xurl
 #  Usage   : cd <repo> && docs/tools/README_pdf.sh
 # =============================================================================
@@ -16,6 +16,6 @@ pandoc "$repo/README.md" \
   -V mathfont="Latin Modern Math" -V fontsize=10pt -V geometry:margin=1.7cm \
   -V colorlinks=true -V linkcolor=blue -V urlcolor=blue \
   -V hyperrefoptions=bookmarksopen=true -V hyperrefoptions=pdfpagemode=UseOutlines \
-  -M title="AB Power Meter Monitor 1.6.3 - Deployment and Integration Guide" \
+  -M title="AB Power Meter Monitor 1.6.4 - Deployment and Integration Guide" \
   -M author="William W. Wallace, NRAO/GBO" -M date="2026-10-27" --toc --toc-depth=2
 echo "written: $repo/README.pdf"
diff --git a/environment-py37.yml b/environment-py37.yml
index 4ff6f6b..f7988b6 100644
--- a/environment-py37.yml
+++ b/environment-py37.yml
@@ -11,6 +11,10 @@
 # Activate: mamba activate abmeter37
 #
 # NOTE: run from the directory that contains requirements-py37.txt.
+# 2026-10-27: python 3.7.12 (conda-forge's last 3.7) + pip 24.0 (the last pip for
+# 3.7; it reads the manylinux_2_28 wheel tags the pip bundled with 3.7 cannot).
+# Verified on Linux x86-64 (glibc >= 2.28, e.g. RHEL 9): all pins install as
+# wheels; monitor, exporter and dashboard tests pass.
 # If conda-forge cannot provide python 3.7.11 exactly, relax to  python=3.7
 # (the latest 3.7.x it offers still satisfies the >=3.7.11 support floor if
 #  it is 3.7.11 or newer; otherwise install 3.7.11 via pyenv + plain venv).
@@ -19,7 +23,7 @@ name: abmeter37
 channels:
   - conda-forge
 dependencies:
-  - python=3.7.11
-  - pip
+  - python=3.7.12
+  - pip=24.0
   - pip:
       - -r requirements-py37.txt
diff --git a/install.sh b/install.sh
index 9e4188b..b37cdc7 100644
--- a/install.sh
+++ b/install.sh
@@ -13,8 +13,11 @@
 #   sudo ./install.sh --only-exporter \
 #        --ips 10.16.130.50,10.16.130.54       # system, exporter only
 #   ./install.sh --user                        # per-user, monitor
-#   sudo ./install.sh --py37                   # pin the 3.7 requirements
+#   sudo ./install.sh --py37                   # pin the 3.7 requirements (needs python3.7)
 #   sudo ./install.sh --mamba                  # mamba env, Python 3.12 (default)
+#   sudo ./install.sh --mamba --py37 --only-exporter     # RHEL 9 + Python 3.7
+#   sudo ./install.sh --only-exporter --once-timer \
+#        --push-gateway http://localhost:9091   # single runs every 60 s (timer)
 #   sudo ./install.sh --python /opt/conda/envs/abmeter/bin/python   # use a
 #                                              #   pre-made (e.g. mamba) env
 #
@@ -24,8 +27,11 @@
 #   --exporter          also install the exporter service
 #   --only-exporter     install ONLY the exporter (no monitor)
 #   --python PATH       use this interpreter; skip venv/mamba creation
